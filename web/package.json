{
  "name": "dmw-web",
  "private": true,
  "type": "module",
  "scripts": {
    "build:wasm": "bash ../scripts/build-wasm.sh && mkdir -p src/wasm && cp ../build-wasm/dist/dmw.mjs ../build-wasm/dist/dmw.wasm src/wasm/ && cp ../build-wasm/dist/dmw.d.ts src/wasm/dmw.d.mts",
    "typecheck": "tsc --noEmit",
    "smoke": "node src/smoke.ts",
    "dev": "vite",
    "build": "vite build",
    "bench": "node src/bench.ts",
    "preview": "vite preview",
    "record-demo": "node scripts/record-demo.mjs"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "@types/three": "0.186.0",
    "gifenc": "^1.0.3",
    "playwright-core": "^1.64.0",
    "typescript": "7.0.2",
    "vite": "8.3.2"
  },
  "dependencies": {
    "three": "0.186.1"
  }
}
